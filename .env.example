# Configuración del envío de correo del formulario de reserva.
#
# Copiar a .env en el servidor (NUNCA subir el .env al repositorio) o
# declarar estas variables en la unidad de systemd.
#
# Datos SMTP de IONOS:
#   servidor  smtp.ionos.es
#   puerto    587 con STARTTLS  (recomendado)  |  465 con TLS directo
#   usuario   la dirección completa del buzón
#   clave     la del buzón — no la de la cuenta de cliente de IONOS
#
# El código exige TLS: en el puerto 587 se niega a enviar si el servidor
# no ofrece STARTTLS, en vez de mandar las credenciales en claro.

SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=reservas@almadraba08.com
SMTP_PASS=

# Remitente. Debe ser una dirección del propio dominio: si aquí se pusiera
# la del visitante, el correo fallaría SPF y DKIM y acabaría en spam. La
# dirección del visitante viaja en Reply-To, así que basta con dar a
# «Responder» para contestarle.
MAIL_FROM=reservas@almadraba08.com

# Dónde queréis recibir las solicitudes.
MAIL_TO=hola@almadraba08.com

# Interfaz y puerto del proceso Node. Se queda en local: quien atiende
# Internet es Nginx, que hace de proxy inverso por delante.
HOST=127.0.0.1
PORT=4321
