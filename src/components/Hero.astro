---
import Photo from './Photo.astro';
import type { Dict } from '../i18n/ui';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="hero" id="top">
  <Photo
    hueco="hero"
    class="hero-photo"
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    alt="Almadraba 8 — la casa, el porche y el jardín"
    label="Foto principal · fachada, porche o jardín"
    eager
  />
  <div class="scrim" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="container hero-inner">
      <h1 class="wordmark hero-wordmark">Almadraba 8</h1>
      <div class="rule" aria-hidden="true"></div>
      <p class="claim">{t.hero.claim}</p>
      <p class="descriptor">{t.hero.descriptor}</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 640px; }
  .hero :global(.hero-photo) { position: absolute; inset: 0; }
  .scrim {
    position: absolute;
    inset: 0;
    /* Dos capas con oficios distintos.
       La primera es legibilidad: una sombra anclada abajo, justo donde va
       el texto, que se disuelve antes de la mitad para no ensuciar la
       fotografía. Sin ella el claim depende de lo que haya debajo — sobre
       una pared blanca al sol desaparece.
       La segunda es atmósfera: mar abajo, cielo arriba, apenas insinuado.
       Medir con `npm run contraste` tras cambiar cualquiera de las dos. */
    background:
      linear-gradient(
        to top,
        rgba(6, 38, 44, 0.9) 0%,
        rgba(6, 38, 44, 0.78) 22%,
        rgba(6, 38, 44, 0.46) 42%,
        rgba(6, 38, 44, 0.12) 60%,
        rgba(6, 38, 44, 0) 72%
      ),
      linear-gradient(
        to top,
        rgba(17, 95, 107, 0.3),
        rgba(58, 167, 159, 0.12) 52%,
        rgba(127, 180, 212, 0.24)
      );
    pointer-events: none;
  }
  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
  }
  .hero-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: 76px;
  }
  .hero-wordmark {
    font-weight: 200;
    font-size: clamp(28px, 4.4vw, 46px);
    letter-spacing: 0.34em;
    padding-left: 0.34em;
    color: var(--on-dark);
    margin: 0;
  }
  .rule { width: 44px; height: 1px; background: var(--sky); }
  .claim {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.8vw, 30px);
    line-height: 1.3;
    color: var(--on-dark);
    max-width: 520px;
    text-wrap: pretty;
    margin: 0;
  }
  .descriptor {
    font-size: clamp(9px, 1.05vw, 10.5px);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding-left: 0.3em;
    color: #cfe0e6;
    margin: 0;
  }
  @media (max-width: 899px) {
    .hero { height: 78vh; min-height: 480px; }
    .hero-inner { padding-bottom: 56px; }
  }
</style>
