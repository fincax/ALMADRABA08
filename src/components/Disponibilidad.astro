---
import availability from '../../public/availability.json';
import type { Lang, Dict } from '../i18n/ui';

interface Props { lang: Lang; t: Dict }
const { lang, t } = Astro.props;

/**
 * La disponibilidad vive en /public/availability.json: los propietarios la
 * editan ahí (o desde GitHub) y el redeploy la publica. Además, el navegador
 * vuelve a pedir el JSON al cargar, de modo que si el archivo se actualiza
 * directamente en el hosting la web lo refleja sin reconstruir.
 */
type Status = 'libre' | 'reservada' | 'consultar';
interface Period {
  id: string;
  start: string;
  end: string;
  label: { es: string; en: string };
  status: Status;
}
// Importado, no leído de disco: la ruta del módulo cambia según cómo
// empaquete Astro, pero la importación se resuelve siempre desde la raíz
// del proyecto. El navegador vuelve a pedir /availability.json al cargar,
// así que editar el archivo en el servidor sigue surtiendo efecto sin
// reconstruir.
const data = availability as {
  updated: string;
  note: { es: string; en: string };
  periods: Period[];
};

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
const fmtUpdated = fmt(data.updated);

const today = new Date().toISOString().slice(0, 10);
const upcoming = data.periods.filter((p) => p.end >= today);
---

<section class="dispo" id="disponibilidad" data-dark>
  <div class="container inner">
    <div class="text reveal">
      <p class="kicker sky">{t.disponibilidad.kicker}</p>
      <h2 class="headline light">{t.disponibilidad.headline}</h2>
      <p class="copy soft">{t.disponibilidad.p1}</p>
      <p class="copy soft">{t.disponibilidad.p2}</p>
      <p class="note">
        {data.note[lang]}
        <span class="updated" data-updated-prefix={t.disponibilidad.updatedPrefix}>
          {t.disponibilidad.updatedPrefix} {fmtUpdated}.
        </span>
      </p>
    </div>

    <div
      class="list reveal"
      id="availability-list"
      data-lang={lang}
      data-status-libre={t.disponibilidad.status.libre}
      data-status-reservada={t.disponibilidad.status.reservada}
      data-status-consultar={t.disponibilidad.status.consultar}
      data-request-label={t.disponibilidad.request}
      data-empty={t.disponibilidad.empty}
    >
      {
        upcoming.length === 0 ? (
          <p class="empty">{t.disponibilidad.empty}</p>
        ) : (
          upcoming.map((p) => (
            <div class="row" data-status={p.status}>
              <div class="row-main">
                <div class="row-label">{p.label[lang]}</div>
                <div class="row-dates">
                  {fmt(p.start)} — {fmt(p.end)}
                </div>
              </div>
              <div class="row-side">
                <span class={`status s-${p.status}`}>{t.disponibilidad.status[p.status]}</span>
                {p.status !== 'reservada' && (
                  <a
                    class="request"
                    href="#contacto"
                    data-start={p.start}
                    data-end={p.end}
                  >
                    {t.disponibilidad.request}
                  </a>
                )}
              </div>
            </div>
          ))
        )
      }
      <div class="row rest">
        <div class="row-main">
          <div class="row-label">{t.disponibilidad.restoLabel}</div>
        </div>
        <div class="row-side">
          <span class="status s-resto">{t.disponibilidad.restoValue}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .dispo { background: var(--night); }
  .dispo .inner {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--col-gap);
  }
  .dispo .text { display: flex; flex-direction: column; gap: 22px; }
  .dispo .kicker.sky { color: var(--sky-on-dark); }
  .dispo .headline.light { color: var(--on-dark); font-size: clamp(28px, 3.2vw, 38px); }
  .dispo .copy.soft { color: var(--on-dark-soft); }
  .dispo .note {
    font-size: 13px;
    line-height: 1.7;
    color: rgba(191, 212, 214, 0.75);
    margin: 6px 0 0;
    text-wrap: pretty;
  }
  .dispo .updated { display: block; margin-top: 2px; color: rgba(191, 212, 214, 0.55); }

  .dispo .list { display: flex; flex-direction: column; }
  .dispo .empty { color: var(--on-dark-soft); font-size: 15px; line-height: 1.7; margin: 0; padding: 20px 0; }
  .dispo .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(191, 212, 214, 0.28);
  }
  .dispo .row-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .dispo .row-label { font-size: 15px; color: var(--on-dark); letter-spacing: 0.06em; }
  .dispo .row-dates { font-size: 12px; color: rgba(191, 212, 214, 0.65); letter-spacing: 0.04em; }
  .dispo .row-side { display: flex; align-items: baseline; gap: 18px; flex-shrink: 0; }
  .dispo .status {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .dispo .s-libre { color: var(--sea-light); }
  .dispo .s-reservada { color: rgba(191, 212, 214, 0.45); }
  .dispo .s-consultar { color: var(--on-dark-soft); }
  .dispo .s-resto { color: rgba(191, 212, 214, 0.55); }
  .dispo .request {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--abyss);
    background: var(--sky);
    padding: 7px 14px;
    transition: background var(--transition), color var(--transition);
  }
  .dispo .request:hover { background: var(--sea-light); color: var(--abyss); }
  @media (max-width: 899px) {
    .dispo .inner { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .dispo .row { flex-wrap: wrap; align-items: center; }
  }
</style>

<script>
  // Refresco en cliente: vuelve a pedir availability.json para que una
  // edición del archivo en el hosting se refleje sin reconstruir la web.
  // Si la petición falla, queda el estado renderizado en el build.
  type Status = 'libre' | 'reservada' | 'consultar';
  interface Period {
    id: string;
    start: string;
    end: string;
    label: { es: string; en: string };
    status: Status;
  }

  const list = document.getElementById('availability-list');

  async function refresh() {
    if (!list) return;
    let data: { updated: string; periods: Period[] };
    try {
      const res = await fetch('/availability.json', { cache: 'no-cache' });
      if (!res.ok) return;
      data = await res.json();
    } catch {
      return;
    }
    const lang = (list.dataset.lang === 'en' ? 'en' : 'es') as 'es' | 'en';
    const locale = lang === 'es' ? 'es-ES' : 'en-GB';
    const fmt = (iso: string) =>
      new Date(iso + 'T12:00:00').toLocaleDateString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
    const statusLabel: Record<Status, string> = {
      libre: list.dataset.statusLibre ?? '',
      reservada: list.dataset.statusReservada ?? '',
      consultar: list.dataset.statusConsultar ?? '',
    };
    const today = new Date().toISOString().slice(0, 10);
    const upcoming = (data.periods ?? []).filter(
      (p) => p && p.end >= today && ['libre', 'reservada', 'consultar'].includes(p.status)
    );

    const restRow = list.querySelector('.row.rest');
    list.querySelectorAll('.row:not(.rest), .empty').forEach((el) => el.remove());

    const frag = document.createDocumentFragment();
    if (upcoming.length === 0) {
      const p = document.createElement('p');
      p.className = 'empty';
      p.textContent = list.dataset.empty ?? '';
      frag.appendChild(p);
    }
    for (const p of upcoming) {
      const row = document.createElement('div');
      row.className = 'row';
      row.dataset.status = p.status;

      const main = document.createElement('div');
      main.className = 'row-main';
      const label = document.createElement('div');
      label.className = 'row-label';
      label.textContent = p.label?.[lang] ?? p.label?.es ?? '';
      const dates = document.createElement('div');
      dates.className = 'row-dates';
      dates.textContent = `${fmt(p.start)} — ${fmt(p.end)}`;
      main.append(label, dates);

      const side = document.createElement('div');
      side.className = 'row-side';
      const st = document.createElement('span');
      st.className = `status s-${p.status}`;
      st.textContent = statusLabel[p.status];
      side.appendChild(st);
      if (p.status !== 'reservada') {
        const a = document.createElement('a');
        a.className = 'request';
        a.href = '#contacto';
        a.dataset.start = p.start;
        a.dataset.end = p.end;
        a.textContent = list.dataset.requestLabel ?? '';
        side.appendChild(a);
      }
      main && side && row.append(main, side);
      frag.appendChild(row);
    }
    list.insertBefore(frag, restRow);

    const updated = document.querySelector<HTMLElement>('.updated');
    if (updated && data.updated) {
      updated.textContent = `${updated.dataset.updatedPrefix} ${fmt(data.updated)}.`;
    }
  }
  refresh();

  // Delegación: los botones «Solicitar» rellenan las fechas del formulario.
  list?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.request');
    if (!a) return;
    const arrival = document.querySelector<HTMLInputElement>('#f-arrival');
    const departure = document.querySelector<HTMLInputElement>('#f-departure');
    if (arrival && a.dataset.start) arrival.value = a.dataset.start;
    if (departure && a.dataset.end) departure.value = a.dataset.end;
  });
</script>
