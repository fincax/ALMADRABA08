---
/**
 * Página de aviso legal y privacidad, común a ES y EN.
 *
 * Los datos del titular salen de `site.legal`. Si falta alguno se pinta un
 * aviso visible en su lugar: es preferible que cante en pantalla a que la
 * web se publique con un aviso legal incompleto.
 */
import { site } from '../data/site';
import type { Lang, Dict } from '../i18n/ui';
import type { LegalDict } from '../i18n/legal';

interface Props { lang: Lang; t: Dict; l: LegalDict; updated: string }
const { lang, t, l, updated } = Astro.props;

const ident = [
  { k: l.aviso.identId, v: site.legal.holder },
  { k: l.aviso.identTax, v: site.legal.taxId },
  { k: l.aviso.identPostal, v: site.legal.postal },
  { k: l.aviso.identEmail, v: site.legal.email },
  { k: l.aviso.identSite, v: site.domain },
];
const home = lang === 'es' ? '/' : '/en/';
---

<article class="legal container">
  <a class="volver" href={home}>← {l.back}</a>

  <section class="bloque" id="aviso-legal">
    <p class="kicker">{l.aviso.kicker}</p>
    <h1 class="headline">{l.aviso.headline}</h1>

    <dl class="ident">
      {ident.map((row) => (
        <div class="fila">
          <dt>{row.k}</dt>
          <dd>{row.v ? row.v : <mark class="pendiente">{l.pending}</mark>}</dd>
        </div>
      ))}
    </dl>

    {l.aviso.blocks.map((b) => (
      <div class="parrafo">
        <h2>{b.h}</h2>
        <p>{b.p}</p>
      </div>
    ))}
  </section>

  <section class="bloque" id="privacidad">
    <p class="kicker">{l.privacidad.kicker}</p>
    <h2 class="headline">{l.privacidad.headline}</h2>
    <p class="intro">{l.privacidad.intro}</p>

    <dl class="filas">
      {l.privacidad.rows.map((row) => (
        <div class="fila">
          <dt>{row.k}</dt>
          <dd>{row.v}</dd>
        </div>
      ))}
    </dl>

    <p class="updated">{l.privacidad.updated}: {updated}</p>
  </section>
</article>

<style>
  .legal {
    padding-top: 60px;
    padding-bottom: var(--section-y);
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .volver {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .volver:hover { color: var(--teal-deep); }
  .bloque { display: flex; flex-direction: column; gap: 22px; }
  .headline {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.25;
    color: var(--ink);
  }
  .intro { font-size: 16px; line-height: 1.75; color: var(--ink-soft); }

  .ident { margin: 0 0 8px; display: flex; flex-direction: column; }
  .ident .fila { border-bottom: 1px solid var(--line); }
  .filas { margin: 0; display: flex; flex-direction: column; }
  .fila {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 6px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .fila:last-child { border-bottom: 0; }
  dt {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }
  dd { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink-soft); }

  .pendiente {
    background: #FBE3D6;
    color: #8A3B12;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    padding: 3px 8px;
  }

  .parrafo { display: flex; flex-direction: column; gap: 9px; }
  .parrafo h2 {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
    font-weight: 400;
  }
  .parrafo p { font-size: 15px; line-height: 1.75; color: var(--ink-soft); }

  .updated { margin-top: 6px; font-size: 12px; color: var(--muted); }

  @media (max-width: 899px) {
    .fila { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    dt { padding-top: 0; }
  }
</style>
